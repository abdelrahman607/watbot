# انسخ إلى .env.production.local على الـ VPS (أو صدّر المتغيرات في systemd / PM2)
# cp deploy/env.vps.example .env.production.local

NODE_ENV=production
PORT=3000

# Chromium نظامي (Ubuntu/Debian بعد: sudo apt install -y chromium-browser أو chromium)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# إن كان المسار مختلفاً: which chromium

# Laravel — نفس السر
LARAVEL_WHATSAPP_SECRET=

# عنوان التطبيق العام (للعامل اختياري)
SENDSTACK_INTERNAL_URL=https://YOUR_VPS_DOMAIN_OR_IP:3000

# تعطيل تنزيل Chrome الثقيل من npm إن استخدمت chromium النظامي فقط
SKIP_PUPPETEER_CHROME=1

# اختياري — عامل صف Laravel
# LARAVEL_DATABASE_URL=mysql://user:pass@127.0.0.1:3306/dbname
