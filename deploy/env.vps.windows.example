# انسخ إلى .env.production.local في جذر SendStack على Windows Server
# copy deploy\env.vps.windows.example .env.production.local

NODE_ENV=production
PORT=3000

# Chrome المثبت على السيرفر (عدّل إن كان المسار مختلفاً)
# أمثلة شائعة:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Laravel — نفس السر
LARAVEL_WHATSAPP_SECRET=

# عنوان يصل إليه Laravel — استخدم الـ IP العام للـ VPS أو الدومين، وليس 169.254.x.x
# (عناوين 169.254.* link-local ولا تصل من الإنترنت)
SENDSTACK_INTERNAL_URL=http://YOUR_PUBLIC_IPV4_OR_DOMAIN:3000

# على Windows غالباً تترك Puppeteer يحمّل Chrome المرفق مع الحزمة؛
# إن عرّفت PUPPETEER_EXECUTABLE_PATH لمتصفح مثبت، يمكنك:
# SKIP_PUPPETEER_CHROME=1

# اختياري — عامل صف Laravel
# LARAVEL_DATABASE_URL=mysql://user:pass@127.0.0.1:3306/dbname
